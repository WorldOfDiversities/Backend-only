# Django core
DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS/CSRF
DJANGO_CORS_ALLOW_ALL=True
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=False
JWT_BLACKLIST_AFTER_ROTATION=True

# Security (production)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# PostgreSQL / Supabase
# Prefer DATABASE_URL for remote Supabase Postgres connections.
# Example (replace YOUR-PASSWORD with your Supabase database password):
# DATABASE_URL=postgresql://postgres.ecdjhltsmxfokzlsweuo:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Local fallback (used only when DATABASE_URL is empty)
DB_NAME=Django_Project
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# Supabase API keys (not used for Django database connection)
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Paystack (test mode)
PAYSTACK_PUBLIC_KEY=pk_test_bf3060e253b2d9a147924b9660bed80f7e9d5ea9
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_secret_key
PAYSTACK_BASE_URL=https://api.paystack.co

# Frontend URL for reset links
FRONTEND_URL=http://127.0.0.1:5500
PASSWORD_RESET_URL_TEMPLATE=

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
SUPPORT_EMAIL=support@example.com
APP_NAME=SwiftPOS
